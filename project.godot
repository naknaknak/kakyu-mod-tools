; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kakyu Mod Tools"
run/main_scene="res://tools/content_suite/apps/content_suite_launcher.tscn"
config/features=PackedStringArray("4.7")
run/main_scene.arc_browser="res://tools/content_suite/apps/arc_browser.tscn"
run/main_scene.mes_editor="res://tools/content_suite/apps/mes_editor.tscn"
run/main_scene.image_editor="res://tools/content_suite/apps/image_arc_editor.tscn"
run/main_scene.audio_editor="res://tools/content_suite/apps/audio_arc_editor.tscn"
run/main_scene.event_player="res://tools/content_suite/apps/event_player.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
