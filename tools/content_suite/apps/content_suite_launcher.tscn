[connection signal="pressed" from="Margin/Layout/Tools/AudioRow/Launch" to="." method="_on_audio_editor_pressed"]
[connection signal="pressed" from="Margin/Layout/Tools/MesRow/Launch" to="." method="_on_mes_editor_pressed"]
[connection signal="pressed" from="Margin/Layout/Tools/EventRow/Launch" to="." method="_on_event_player_pressed"]
[connection signal="pressed" from="Margin/Layout/Tools/ImageRow/Launch" to="." method="_on_image_editor_pressed"]
[connection signal="pressed" from="Margin/Layout/Validation" to="." method="_on_validation_pressed"]
[connection signal="file_selected" from="ArchiveDialog" to="." method="_on_archive_selected"]
[connection signal="dir_selected" from="ContentSetDialog" to="." method="_on_content_set_selected"]
