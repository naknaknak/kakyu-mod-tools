[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://tools/content_suite/apps/mes_editor.gd" id="1_script"]

[sub_resource type="Theme" id="Theme_mes_editor"]
default_font_size = 11

[node name="MesEditor" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_mes_editor")
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Toolbar" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="Open" type="Button" parent="Margin/Layout/Toolbar"]
